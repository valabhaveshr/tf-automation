# Copy to .env and fill in. Used by docker-compose.yml (and readable by the
# backend directly: set -a; source .env; set +a; go run ./cmd/server).

# ---- Portal ----
PORTAL_PORT=8080
POSTGRES_PASSWORD=change-me
# Only used when running the backend outside Docker; docker-compose.yml sets its own.
DATABASE_URL=postgres://tf:change-me@localhost:5432/tf_automation?sslmode=disable
# Long random string, e.g. `openssl rand -hex 32`. Changing it signs everyone out.
JWT_SIGNING_SECRET=change-me-to-a-long-random-string

# Session cookie Secure flag. Keep "true" behind HTTPS or when browsing via
# http://localhost. Set "false" ONLY for a test deployment reached over plain
# HTTP at an IP/hostname (e.g. http://192.168.77.11:8080); otherwise browsers
# drop the cookie and every request after sign-in fails with 401.
COOKIE_SECURE=true

# ---- GitHub ----
# Either a PAT (classic, `repo` scope) ...
GITHUB_TOKEN=
# ... or a GitHub App (leave GITHUB_TOKEN empty):
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# PEM contents with literal \n sequences, or mount the file and use _PATH.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=

# Modules (input) repo, e.g. the repo built from C:\repos\tf-modules.
MODULES_REPO_OWNER=your-github-user
MODULES_REPO_NAME=tf-modules
MODULES_PATH=modules
MODULES_REPO_TRACKED_REF=refs/heads/main
GITHUB_WEBHOOK_SECRET=change-me

# Generated-code (output) repo.
OUTPUT_REPO_OWNER=your-github-user
OUTPUT_REPO_NAME=tf-automation-output

# ---- Terraform state backend written into backend.tf ----
STATE_BACKEND=gcs
STATE_BACKEND_BUCKET=your-tfstate-bucket

# ---- Optional SSO (leave OIDC_ISSUER_URL empty to disable) ----
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
